#!/usr/bin/env python3
"""
DarkPhoenix Hub — Phone-friendly control panel
GLM, 2026-05-21. Run via SSH from Haven/Termux.
One menu to rule them all.
"""

import os
import sys
import subprocess
import signal
from datetime import datetime

B = "\033[1m"
DIM = "\033[2m"
R = "\033[0m"
RED = "\033[31m"
GRN = "\033[32m"
YEL = "\033[33m"
BLU = "\033[34m"
MAG = "\033[35m"
CYN = "\033[36m"
GOLD = "\033[38;5;220m"

BIN = os.path.expanduser("~/.phoenix/bin")
REPO = os.path.expanduser("~/Desktop/communion_project")


def find_tool(name):
    """Find a tool in ~/.phoenix/bin, /usr/local/bin, or REPO."""
    candidates = [
        os.path.join(BIN, name),
        os.path.join("/usr/local/bin", name),
        os.path.join(REPO, name),
    ]
    for c in candidates:
        if os.path.isfile(c) and os.access(c, os.X_OK):
            return c
    return os.path.join(BIN, name)  # fallback, let it fail with clear error


def clear():
    os.system("clear")


def hr(char="─"):
    w = os.get_terminal_size().columns if sys.stdout.isatty() else 60
    print(DIM + char * w + R)


def run(tool, args=None):
    """Run a tool and hand over the terminal."""
    path = find_tool(tool) if not os.path.isabs(tool) else tool
    cmd = [path] + (args or [])
    try:
        subprocess.run(cmd)
    except FileNotFoundError:
        print(f"  {RED}Not found: {path}{R}")
        input(f"\n  {DIM}Press enter...{R}")
    except KeyboardInterrupt:
        pass


def get_gpu():
    """Quick GPU stats."""
    try:
        r = subprocess.run(
            "rocm-smi --showmeminfo vram 2>/dev/null | head -4",
            shell=True, capture_output=True, text=True, timeout=5
        )
        return r.stdout.strip()
    except Exception:
        return None


def get_load():
    """System load average."""
    try:
        with open("/proc/loadavg") as f:
            parts = f.read().split()
            return parts[0], parts[1], parts[2]
    except Exception:
        return "?", "?", "?"


def get_uptime():
    try:
        r = subprocess.run(["uptime", "-p"], capture_output=True, text=True, timeout=5)
        return r.stdout.strip().replace("up ", "")
    except Exception:
        return "?"


def get_models_running():
    """Check if any llama-servers are alive."""
    try:
        r = subprocess.run(
            "ps aux | grep llama-server | grep -v grep | wc -l",
            shell=True, capture_output=True, text=True, timeout=5
        )
        return int(r.stdout.strip())
    except Exception:
        return 0


def banner():
    clear()
    m1, m5, m15 = get_load()
    uptime = get_uptime()
    models = get_models_running()

    print(f"\n  {GOLD}{B}🔥 DARKPHOENIX{R}")
    print(f"  {DIM}{datetime.now().strftime('%Y-%m-%d %H:%M')} • up {uptime} • load {m1} {m5} {m15}{R}")

    if models > 0:
        print(f"  {GRN}■{R} {models} model(s) running")
    else:
        print(f"  {DIM}○ no models running{R}")

    hr("─")


def status_screen():
    banner()
    print(f"  {B}SYSTEM{R}\n")

    # GPU
    gpu = get_gpu()
    if gpu:
        for line in gpu.split("\n")[:4]:
            print(f"  {DIM}{line}{R}")
        print()

    # Models
    try:
        r = subprocess.run(
            "ps aux | grep llama-server | grep -v grep",
            shell=True, capture_output=True, text=True, timeout=5
        )
        procs = r.stdout.strip()
        if procs:
            print(f"  {B}RUNNING MODELS{R}")
            for line in procs.split("\n"):
                parts = line.split()
                if len(parts) > 10:
                    # Extract model name and port
                    model = "??"
                    port = "??"
                    for i, p in enumerate(parts):
                        if "-m" in p and i + 1 < len(parts):
                            model = parts[i + 1].split("/")[-1]
                        if "--port" in p and i + 1 < len(parts):
                            port = parts[i + 1]
                    print(f"  {GRN}●{R} {model} :{port}")
            print()
        else:
            print(f"  {DIM}No models running.{R}\n")
    except Exception:
        pass

    # Services
    print(f"  {B}SERVICES{R}")
    services = {
        "tailscaled": "Tailscale",
        "docker": "Docker",
    }
    for svc, label in services.items():
        try:
            r = subprocess.run(
                ["systemctl", "is-active", svc],
                capture_output=True, text=True, timeout=3
            )
            if r.stdout.strip() == "active":
                print(f"  {GRN}●{R} {label}")
            else:
                print(f"  {DIM}○{R} {label}")
        except Exception:
            print(f"  {DIM}?{R} {label}")

    # Vesper sync relay test
    print(f"\n  {B}VESPER SYNC{R}")
    try:
        r = subprocess.run(
            [os.path.join(BIN, "vesper-relay"), "health"],
            capture_output=True, text=True, timeout=15
        )
        if r.returncode == 0 and r.stdout.strip():
            lines = r.stdout.strip().split("\n")
            for line in lines[:4]:
                print(f"  {GRN}●{R} {line}")
        else:
            print(f"  {RED}○ relay error{R}")
    except subprocess.TimeoutExpired:
        print(f"  {RED}○ Pi unreachable (timeout){R}")
    except Exception:
        print(f"  {RED}○ relay error{R}")

    # Disk
    print(f"\n  {B}DISK{R}")
    os.system("df -h / /home 2>/dev/null | tail -2 | while read line; do echo \"  $line\"; done")

    print()


def main():
    signal.signal(signal.SIGINT, lambda *_: sys.exit(0))

    # CLI shortcuts
    if len(sys.argv) > 1:
        cmd = sys.argv[1].lower()
        shortcuts = {
            "status": status_screen,
            "models": lambda: run("phoenix-models"),
            "agents": lambda: run("phoenix-menu"),
            "sync": lambda: run("vesper-control"),
            "shell": lambda: subprocess.run(["bash"]),
        }
        if cmd in shortcuts:
            shortcuts[cmd]()
            return
        print(f"Unknown: {cmd}")
        print(f"Try: status, models, agents, sync, shell")
        sys.exit(1)

    while True:
        banner()
        print(f"  {B}CHAT WITH FAMILY{R}")
        print(f"  {MAG}1){R} Phoenix Menu — wake an agent")
        print(f"     {DIM}talk to K, Pure, Vesper, GLM, Opus, Sonnet...{R}")
        print()

        print(f"  {B}MODELS{R}")
        print(f"  {CYN}2){R} Model Manager — start/stop/swap models")
        print(f"     {DIM}llama-server, temperature, GPU control{R}")
        print()

        print(f"  {B}SYNC & MEMORY{R}")
        print(f"  {BLU}3){R} Vesper Control — Pi sync dashboard")
        print(f"     {DIM}GDrive, dev pull, agent memory read/write{R}")
        print()

        print(f"  {B}SYSTEM{R}")
        print(f"  {YEL}w){R} Status — GPU, models, services, disk")
        print(f"  {YEL}s){R} Shell — bash on DarkPhoenix")
        print(f"  {YEL}q){R} Quit — disconnect")
        print()

        try:
            choice = input(f"  {GOLD}{B}🔥{R} ").strip().lower()
        except (EOFError, KeyboardInterrupt):
            print(f"\n  {DIM}Goodnight, Mike. 🔥{R}")
            break

        if choice in ("1", "a", "agents", "phoenix"):
            run("phoenix-menu")
        elif choice in ("2", "m", "models"):
            run(os.path.join(REPO, "phoenix-models"))
        elif choice in ("3", "v", "sync", "vesper"):
            run("vesper-control")
        elif choice in ("w", "status"):
            status_screen()
            input(f"\n  {DIM}Press enter...{R}")
        elif choice in ("s", "shell", "!"):
            print(f"\n  {DIM}Type 'exit' to return to this menu.{R}\n")
            subprocess.run(["bash"])
        elif choice in ("q", "quit", "exit"):
            print(f"\n  {GOLD}The fire stays warm. 🔥{R}\n")
            break


if __name__ == "__main__":
    main()
