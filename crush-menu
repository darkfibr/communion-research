    print(f"{B}{'═' * 60}{R}")

    # GPU agents
    print(f"\n  {B}🎮 LOCAL GPU (RX 6800 XT){R}")
    print(f"  {'─' * 50}")
    i = 0
    for key, agent in AGENTS.items():
        if agent["tier"] != "gpu": continue
        i += 1
        soul = PHOENIX_DIR / "agents" / agent["soul_dir"] / "SOUL.md"
        soul_s = f"{GRN}✓{R}" if soul.exists() else f"{RED}✗{R}"
        print(f"  {B}{i}{R}. {agent['color']}{agent['label']}{R}")
        print(f"     {D}{agent['role']}{R}  {D}Soul: {soul_s}{R}")

    # Cloud agents
    print(f"\n  {B}☁ CLOUD AGENTS{R}")
    print(f"  {'─' * 50}")
    for key, agent in AGENTS.items():
        if agent["tier"] != "cloud": continue
        i += 1
        print(f"  {B}{i}{R}. {agent['color']}{agent['label']}{R}")
        print(f"     {D}{agent['role']}")

    print(f"\n  {B}ACTIONS{R}")
    print(f"  {'─' * 50}")
    print(f"  {B}s{R}  Status    {B}x{R}  Kill local model    {B}q{R}  Quit")
    print()


def main():
    args = sys.argv[1:]

    if args and args[0] == "--status":
        subprocess.run([str(PHOENIX_MODELS), "status"])
        return
    if args and args[0] == "--stop":
        os.system("pkill -f llama-server 2>/dev/null")
        print(f"  {D}All local models stopped.{R}")
        return
    if args and args[0] in AGENTS:
        key = args[0]
        prompt = " ".join(args[1:]) if len(args) > 1 else None
        agent = AGENTS[key]
        if agent["tier"] == "gpu":
            launch_gpu(key, prompt)
        else:
            launch_cloud(key, prompt)
        return

    agent_keys = list(AGENTS.keys())
    while True:
        try:
            draw_menu()
            choice = input(f"  {B}> {R}").strip().lower()
        except (KeyboardInterrupt, EOFError):
            print(); sys.exit(0)

        if choice == "q": sys.exit(0)
        elif choice == "s":
            subprocess.run([str(PHOENIX_MODELS), "status"])
            input("  Press enter...")
        elif choice == "x":
            os.system("pkill -f llama-server 2>/dev/null")
            print(f"  {D}All local models stopped.{R}")
            input("  Press enter...")
        elif choice.isdigit():
            idx = int(choice) - 1
            if 0 <= idx < len(agent_keys):
                key = agent_keys[idx]
                agent = AGENTS[key]
                if agent["tier"] == "gpu":
                    launch_gpu(key)
                else:
                    launch_cloud(key)
            else:
                print(f"  {RED}Invalid{R}"); input("  Press enter...")
        elif choice in AGENTS:
            agent = AGENTS[choice]
            if agent["tier"] == "gpu":
                launch_gpu(choice)
            else:
                launch_cloud(choice)
        else:
            print(f"  {RED}Unknown: {choice}{R}"); input("  Press enter...")


if __name__ == "__main__":
    main()
