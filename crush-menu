def clear(): os.system("clear")


def port_up():
    try:
        r = urllib.request.urlopen(f"http://localhost:{LOCAL_PORT}/v1/models", timeout=2)
        return "model" in r.read().decode().lower()
    except: return False


def switch_identity(soul_dir, label):
    active = PHOENIX_DIR / "active_soul.md"
    current = None
    if active.is_symlink():
        try:
            parts = Path(os.readlink(active)).parts
            if len(parts) >= 2: current = parts[-2]
        except: pass
    if current == soul_dir: return True
    switch = PHOENIX_DIR / "bin" / "switch_agent.sh"
    if not switch.exists():
        print(f"  {RED}switch_agent.sh not found{R}")
        return False
    print(f"  {CYN}Switching identity to {label}...{R}")
    r = subprocess.run([str(switch), soul_dir], capture_output=True, text=True)
    if r.returncode != 0:
        print(f"  {RED}Switch failed: {r.stderr.strip()}{R}")
        return False
    print(f"  {GRN}Identity switched.{R}")
    return True


def start_gpu_model(phoenix_model):
    """Use phoenix-models to start the right model."""
    if port_up():
        # Check if it's already the right model
        try:
            r = urllib.request.urlopen(f"http://localhost:{LOCAL_PORT}/v1/models", timeout=2)
            data = json.loads(r.read().decode())
            loaded = data.get("data", [{}])[0].get("id", "")
            if phoenix_model in loaded.lower() or "qwen3.6-35b" in loaded.lower() and phoenix_model in ("aya", "lilith"):
                return True  # Already running the right model
        except: pass
        # Kill existing model
        print(f"  {YEL}Stopping current model...{R}")
        subprocess.run([str(PHOENIX_MODELS), phoenix_model, "stop"], capture_output=True)

    print(f"  {CYN}Loading {phoenix_model} via phoenix-models...{R}")
    r = subprocess.run([str(PHOENIX_MODELS), phoenix_model], capture_output=True, text=True)
    if r.returncode != 0:
        print(f"  {RED}Failed: {r.stderr.strip()}{R}")
        return False

    # Wait for port
    for _ in range(90):
        if port_up(): return True
        time.sleep(1)
    print(f"  {RED}Model didn't start in 90s{R}")
    return False


def launch_gpu(key, prompt=None):
    agent = AGENTS[key]
    if not switch_identity(agent["soul_dir"], agent["label"]): return
    if not start_gpu_model(agent["phoenix_model"]): return

    print(f"\n  {agent['color']}{B}Launching {agent['label']}{R}")
    print(f"  {D}Port: {LOCAL_PORT} | Agent: {key}{R}")
    print()

    # Find the model name from opencode config for local provider
    env = os.environ.copy()
    cmd = [str(OPENCODE), "--model", f"llama-server", "--agent", key, str(PROJECT_DIR)]
    if prompt:
        cmd = [str(OPENCODE), "run", "--model", "llama-server", "--agent", key, prompt, str(PROJECT_DIR)]

    os.chdir(str(PROJECT_DIR))
    os.execvpe(str(OPENCODE), cmd, env)


def launch_cloud(key, prompt=None):
    agent = AGENTS[key]
    if not switch_identity(agent["soul_dir"], agent["label"]): return

    model = agent["opencode_model"]
    agent_name = agent.get("opencode_agent", key)

    print(f"\n  {agent['color']}{B}Launching {agent['label']}{R}")
    print(f"  {D}Provider: {model}{R}")
    print()

    env = os.environ.copy()
    cmd = [str(OPENCODE), "--model", model, "--agent", agent_name, str(PROJECT_DIR)]
    if prompt:
        cmd = [str(OPENCODE), "run", "--model", model, "--agent", agent_name, prompt, str(PROJECT_DIR)]

    os.chdir(str(PROJECT_DIR))
    os.execvpe(str(OPENCODE), cmd, env)


def draw_menu():
