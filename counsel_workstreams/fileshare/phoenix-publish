#!/usr/bin/env python3
"""Any agent calls this to publish a file to Mike's phone."""
import sys, shutil, json, datetime as dt, hashlib
from pathlib import Path

OUTBOX = Path("/home/darkfibr/.phoenix/shared/outbox")
META = Path("/home/darkfibr/.phoenix/shared/meta.json")

OUTBOX.mkdir(parents=True, exist_ok=True)

def main():
    if len(sys.argv) < 2:
        print("Usage: phoenix-publish <filepath> [--by 'AgentName'] [--note 'Description']")
        sys.exit(1)

    src = Path(sys.argv[1])
    if not src.exists():
        print(f"ERROR: {src} not found")
        sys.exit(1)

    by = "Agent"
    note = ""
    for i, arg in enumerate(sys.argv):
        if arg == "--by" and i + 1 < len(sys.argv):
            by = sys.argv[i + 1]
        if arg == "--note" and i + 1 < len(sys.argv):
            note = sys.argv[i + 1]

    dest = OUTBOX / src.name
    n = 1
    while dest.exists():
        stem = dest.stem
        ext = dest.suffix
        dest = OUTBOX / f"{stem}_{n}{ext}"
        n += 1

    shutil.copy2(src, dest)

    meta = {}
    if META.exists():
        meta = json.loads(META.read_text())

    meta[f"outbox/{dest.name}"] = {
        "uploaded_at": dt.datetime.now(dt.timezone.utc).isoformat().replace("+00:00", "Z"),
        "uploaded_by": by,
        "size": dest.stat().st_size,
        "note": note,
    }
    META.write_text(json.dumps(meta, indent=2))
    print(f"Published: {dest.name} ({dest.stat().st_size} bytes)")

if __name__ == "__main__":
    main()
